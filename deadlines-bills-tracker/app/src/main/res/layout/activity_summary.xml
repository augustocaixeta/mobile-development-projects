<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.summary.SummaryActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="40dp">

            <ImageButton
                android:id="@+id/back_button"
                style="@style/Widget.EmDia.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="-4dp"
                android:contentDescription="@string/cd_back"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back" />
        </FrameLayout>

        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:paddingTop="12dp"
            android:text="@string/summary_title" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/line_bottom"
            android:orientation="horizontal"
            android:paddingTop="20dp">

            <TextView
                android:id="@+id/tab_week"
                style="@style/Widget.EmDia.Tab"
                android:text="@string/period_week" />

            <TextView
                android:id="@+id/tab_month"
                style="@style/Widget.EmDia.Tab"
                android:layout_marginStart="22dp"
                android:text="@string/period_month" />

            <TextView
                android:id="@+id/tab_year"
                style="@style/Widget.EmDia.Tab"
                android:layout_marginStart="22dp"
                android:text="@string/period_year" />
        </LinearLayout>

        <TextView
            android:id="@+id/total_label"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            tools:text="Pago nesta semana" />

        <TextView
            android:id="@+id/total"
            style="@style/Text.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            tools:text="R$ 3.420,00" />

        <TextView
            android:id="@+id/received"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/positive"
            tools:text="R$ 800,00 recebidos no período" />

        <br.edu.iftm.deadlinetracker.ui.summary.BarChartView
            android:id="@+id/chart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:contentDescription="@string/cd_chart" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include
                android:id="@+id/stat_completed"
                layout="@layout/item_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/stat_pending"
                layout="@layout/item_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/stat_overdue"
                layout="@layout/item_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            style="@style/Text.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="28dp"
            android:text="@string/summary_recent" />

        <LinearLayout
            android:id="@+id/recent_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/no_recent"
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="@string/summary_no_recent"
            android:textColor="@color/text_3"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
