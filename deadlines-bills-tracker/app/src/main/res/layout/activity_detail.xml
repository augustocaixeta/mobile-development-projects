<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.detail.DetailActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/back_button"
            style="@style/Widget.EmDia.IconButton"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back" />

        <ImageButton
            android:id="@+id/more_button"
            style="@style/Widget.EmDia.IconButton"
            android:layout_gravity="end|center_vertical"
            android:contentDescription="@string/cd_more"
            android:src="@drawable/ic_more_horiz" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:visibility="invisible">

            <TextView
                android:id="@+id/overline"
                style="@style/Text.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="a pagar · pendente" />

            <TextView
                android:id="@+id/title"
                style="@style/Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                tools:text="Conta de energia" />

            <TextView
                android:id="@+id/metric_label"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                tools:text="Valor" />

            <TextView
                android:id="@+id/metric"
                style="@style/Text.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                tools:text="R$ 312,00" />

            <TextView
                android:id="@+id/metric_detail"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/positive"
                tools:text="vence em 3 dias · 30 set" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/row_payee"
                    layout="@layout/detail_row" />

                <include
                    android:id="@+id/row_due"
                    layout="@layout/detail_row" />

                <include
                    android:id="@+id/row_repeat"
                    layout="@layout/detail_row" />

                <include
                    android:id="@+id/row_created"
                    layout="@layout/detail_row" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="28dp">

                <TextView
                    style="@style/Text.Overline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/detail_reminders" />

                <TextView
                    android:id="@+id/reminder_count"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="2 agendados" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/reminder_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/no_reminders"
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:text="@string/no_reminders"
                android:textColor="@color/text_3"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/primary_button"
            style="@style/Widget.EmDia.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="@string/action_pay" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/secondary_button"
            style="@style/Widget.EmDia.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/action_edit" />
    </LinearLayout>
</LinearLayout>
