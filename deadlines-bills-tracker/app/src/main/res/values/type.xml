<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Text" parent="">
        <item name="android:fontFamily">@font/schibsted_grotesk_regular</item>
        <item name="fontFamily">@font/schibsted_grotesk_regular</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
        <item name="lineHeight">20sp</item>
    </style>

    <style name="Text.Display">
        <item name="android:fontFamily">@font/ibm_plex_mono_regular</item>
        <item name="fontFamily">@font/ibm_plex_mono_regular</item>
        <item name="android:textSize">34sp</item>
        <item name="lineHeight">40sp</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Text.Title">
        <item name="android:fontFamily">@font/schibsted_grotesk_semibold</item>
        <item name="fontFamily">@font/schibsted_grotesk_semibold</item>
        <item name="android:textSize">22sp</item>
        <item name="lineHeight">28sp</item>
        <item name="android:letterSpacing">-0.009</item>
    </style>

    <style name="Text.Body" />

    <style name="Text.Body.Medium">
        <item name="android:fontFamily">@font/schibsted_grotesk_medium</item>
        <item name="fontFamily">@font/schibsted_grotesk_medium</item>
    </style>

    <style name="Text.Caption">
        <item name="android:textSize">13sp</item>
        <item name="lineHeight">18sp</item>
        <item name="android:textColor">@color/text_2</item>
    </style>

    <style name="Text.Label">
        <item name="android:fontFamily">@font/schibsted_grotesk_medium</item>
        <item name="fontFamily">@font/schibsted_grotesk_medium</item>
        <item name="android:textSize">13sp</item>
        <item name="lineHeight">16sp</item>
    </style>

    <style name="Text.Overline">
        <item name="android:fontFamily">@font/ibm_plex_mono_regular</item>
        <item name="fontFamily">@font/ibm_plex_mono_regular</item>
        <item name="android:textSize">11sp</item>
        <item name="lineHeight">14sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/text_3</item>
    </style>

    <style name="Text.Number">
        <item name="android:fontFamily">@font/ibm_plex_mono_medium</item>
        <item name="fontFamily">@font/ibm_plex_mono_medium</item>
        <item name="android:textSize">20sp</item>
        <item name="lineHeight">24sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Text.Value">
        <item name="android:fontFamily">@font/ibm_plex_mono_regular</item>
        <item name="fontFamily">@font/ibm_plex_mono_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">18sp</item>
    </style>

    <style name="Text.MonoSmall">
        <item name="android:fontFamily">@font/ibm_plex_mono_regular</item>
        <item name="fontFamily">@font/ibm_plex_mono_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="lineHeight">16sp</item>
        <item name="android:textColor">@color/text_2</item>
    </style>

    <style name="TextAppearance.EmDia.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/schibsted_grotesk_medium</item>
        <item name="fontFamily">@font/schibsted_grotesk_medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.EmDia.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/schibsted_grotesk_medium</item>
        <item name="fontFamily">@font/schibsted_grotesk_medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.EmDia.Menu" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/schibsted_grotesk_regular</item>
        <item name="fontFamily">@font/schibsted_grotesk_regular</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="TextAppearance.EmDia.Snackbar" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/schibsted_grotesk_regular</item>
        <item name="fontFamily">@font/schibsted_grotesk_regular</item>
        <item name="android:textSize">15sp</item>
    </style>

</resources>
