<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="150"
    android:exitFadeDuration="150">
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/text" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item
                android:bottom="3dp"
                android:left="23dp"
                android:right="3dp"
                android:top="3dp">
                <shape android:shape="oval">
                    <solid android:color="@color/bg" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/line" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item
                android:bottom="3dp"
                android:left="3dp"
                android:right="23dp"
                android:top="3dp">
                <shape android:shape="oval">
                    <solid android:color="@color/text_2" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
